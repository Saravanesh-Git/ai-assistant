# Optional structured search backend. Browser searches do not require SearXNG.
SEARXNG_URL=http://localhost:8080

# Filesystem access follows OS permissions across all paths.
# Legacy ASSISTANT_ALLOWED_PATHS and ASSISTANT_CONFIRM_ACTIONS are ignored.

# Safety/resource limits
MAX_FILE_SIZE=2097152
MAX_WEB_RESPONSE_SIZE=2097152
WEB_TIMEOUT_SECONDS=10
MAX_CONCURRENT_TOOLS=2
CONVERSATION_HISTORY_LIMIT=12

# Optional Ollama. It is never started and no model is downloaded automatically.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=
LLM_PROVIDER=rule_based

# Logs contain metadata only, never file contents, prompts, tokens, or secrets.
LOG_FILE=local-assistant.log
LOG_LEVEL=INFO


# Non-interactive command timeout (5–600 seconds). Only admin actions ask for approval.
COMMAND_TIMEOUT_SECONDS=120

# Optional override when Windows profile discovery is unavailable on WSL.
# ASSISTANT_WINDOWS_PROFILE=/mnt/c/Users/YourName
