# Local SearXNG is preferred. Web search fails gracefully when unavailable.
SEARXNG_URL=http://localhost:8080

# Comma-separated roots that file tools may access. Defaults to common user folders.
# ASSISTANT_ALLOWED_PATHS=/home/you/Documents,/home/you/Downloads,/home/you/Projects

# Safety/resource limits
MAX_FILE_SIZE=2097152
MAX_WEB_RESPONSE_SIZE=2097152
WEB_TIMEOUT_SECONDS=10
MAX_CONCURRENT_TOOLS=2
CONVERSATION_HISTORY_LIMIT=12

# Optional Ollama. It is never started and no model is downloaded automatically.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=
LLM_PROVIDER=rule_based

# Logs contain metadata only, never file contents, prompts, tokens, or secrets.
LOG_FILE=local-assistant.log
LOG_LEVEL=INFO

